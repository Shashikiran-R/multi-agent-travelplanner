# ==============================================================================
# Dubai AI Travel Planner - Environment Configuration Template
# ==============================================================================

# Groq API Key (Free tier at https://console.groq.com)
# Utilized for: Orchestrator, Destination Research, Logistics Planning, Budget Analysis
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama Configuration (Local or Cloud Hosted)
# Utilized for: Review & QA Agent (Thorough Audit & Compliance Verification)
# ------------------------------------------------------------------------------
# • For Local execution:
#     OLLAMA_BASE_URL=http://localhost:11434
#     OLLAMA_API_KEY=
# • For Cloud execution (e.g. Ollama Cloud, remote VM, RunPod, or hosted proxy):
#     OLLAMA_BASE_URL=https://api.ollama.ai  (or your custom cloud URL)
#     OLLAMA_API_KEY=your_ollama_api_key_here
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-ultra
OLLAMA_API_KEY=your_ollama_api_key_here

# Google Gemini API Key (Legacy optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Note: If API keys or local LLMs are omitted/offline, the planner runs in 100% deterministic offline mode ($0.00).
